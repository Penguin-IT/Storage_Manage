<UserControl x:Class="QuanLyKho.Views.InBaoCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Command="{Binding PrintPdfCommand}" Background="{StaticResource TextDark}" Foreground="White" FontWeight="Bold" Padding="25,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="IN BÁO CÁO (PDF)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="12" Padding="40,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Border Background="White" Width="800" Padding="50,60" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid  Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CÔNG TY TNHH STORAGE PRO" FontWeight="Bold" FontSize="14" Foreground="Black" Margin="0,0,0,5"/>
                                <TextBlock Text="Địa chỉ: Quận Tân Phú, TP.HCM" FontSize="13" Foreground="#333"/>
                                <TextBlock Text="Điện thoại: 0912.345.678" FontSize="13" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Mẫu số: B01-DN" FontWeight="Bold" FontSize="14" Foreground="Black" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                <TextBlock Text="Ban hành theo thông tư BTC" FontSize="13" Foreground="#333" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding TieuDeBaoCao}" FontSize="24" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Kỳ báo cáo: Tháng 05/2026" FontSize="14" FontStyle="Italic" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <DataGrid ItemsSource="{Binding DanhSachBaoCao}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderBrush="Black" BorderThickness="1" RowHeight="35" Margin="0,0,0,40" GridLinesVisibility="All">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F2F2F2"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="0.5*"/>
                                <DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding TenSP}" Width="2*"/>
                                <DataGridTextColumn Header="TỒN ĐẦU KỲ" Binding="{Binding TonDauKy}" Width="1.2*"/>
                                <DataGridTextColumn Header="NHẬP TRONG KỲ" Binding="{Binding NhapTrongKy}" Width="1.5*"/>
                                <DataGridTextColumn Header="XUẤT TRONG KỲ" Binding="{Binding XuatTrongKy}" Width="1.5*"/>
                                <DataGridTextColumn Header="TỒN CUỐI KỲ" Binding="{Binding TonCuoiKy}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Người lập biểu" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                                <TextBlock Text="(Ký, ghi rõ họ tên)" FontStyle="Italic" FontSize="12" Foreground="#555" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Kế toán trưởng" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                                <TextBlock Text="(Ký, ghi rõ họ tên)" FontStyle="Italic" FontSize="12" Foreground="#555" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Giám đốc" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                                <TextBlock Text="(Ký, đóng dấu)" FontStyle="Italic" FontSize="12" Foreground="#555" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>