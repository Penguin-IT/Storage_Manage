<UserControl x:Class="QuanLyKho.Views.DoiMatKhauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuanLyKho.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <conv:MultiPasswordConverter x:Key="MultiPassConverter"/>
    </UserControl.Resources>

    <Border Background="#FAFBFC" CornerRadius="12" Padding="40" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.05"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Đổi Mật Khẩu Hệ Thống" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Mật khẩu hiện tại" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
            <PasswordBox x:Name="txtMatKhauHienTai" Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,20"/>

            <TextBlock Text="Mật khẩu mới" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
            <PasswordBox x:Name="txtMatKhauMoi" Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,20"/>

            <TextBlock Text="Xác nhận lại mật khẩu mới" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
            <PasswordBox x:Name="txtXacNhan" Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,30"/>

            <Button Command="{Binding UpdatePasswordCommand}" Background="{StaticResource SuccessColor}" Foreground="White" FontWeight="Bold" Padding="15" BorderThickness="0" Cursor="Hand">

                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiPassConverter}">
                        <Binding ElementName="txtMatKhauHienTai"/>
                        <Binding ElementName="txtMatKhauMoi"/>
                        <Binding ElementName="txtXacNhan"/>
                    </MultiBinding>
                </Button.CommandParameter>

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="CẬP NHẬT MẬT KHẨU" FontSize="15" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>