<UserControl x:Class="QuanLyKho.Views.ThongKeDoanhThuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Từ Ngày" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <DatePicker Padding="5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" SelectedDate="{Binding TuNgay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Đến Ngày" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <DatePicker Padding="5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" SelectedDate="{Binding DenNgay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Tiêu chí gom nhóm (GroupBy)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <ComboBox Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" 
                              ItemsSource="{Binding DanhSachTieuChi}" 
                              SelectedItem="{Binding TieuChiGomNhom}"/>
                </StackPanel>

                <Button Command="{Binding ThongKeCommand}" Grid.Column="3" VerticalAlignment="Bottom" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="Bold" Padding="30,12" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="THỐNG KÊ"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="12" Padding="25">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4A3AFF" Offset="0"/>
                        <GradientStop Color="#9787FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TỔNG DOANH THU BÁN RA" FontSize="14" FontWeight="SemiBold" Foreground="White" Opacity="0.9" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TongDoanhThu, StringFormat=\{0:N0\} VNĐ}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BgSurface}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding DanhSachThongKe}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="45">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FE"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="15,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="NGÀY GIAO DỊCH / ĐẠI LÝ" Binding="{Binding TenNhom}" Width="2*"/>
                    <DataGridTextColumn Header="SỐ LƯỢNG HÓA ĐƠN" Binding="{Binding SoLuongHoaDon}" Width="1.5*"/>
                    <DataGridTextColumn Header="DOANH THU" Binding="{Binding DoanhThu, StringFormat=\{0:N0\} đ}" Width="1.5*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>