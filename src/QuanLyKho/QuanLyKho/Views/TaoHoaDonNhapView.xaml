<UserControl x:Class="QuanLyKho.Views.TaoHoaDonNhapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Height="600" Width="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Mã Phiếu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MaPN}" IsReadOnly="True" Background="#EEF2F9" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Chọn Nhà Cung Cấp (*)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding DanhSachNCC}" SelectedItem="{Binding SelectedNCC}" DisplayMemberPath="TenNCC" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ngày Lập" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding NgayLap}" Padding="5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FAFBFC" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Tìm Sản Phẩm" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding DanhSachSP}" SelectedItem="{Binding SelectedSP}" DisplayMemberPath="TenSP" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Số Lượng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Đơn Giá Nhập" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DonGiaNhap, UpdateSourceTrigger=PropertyChanged}" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding AddDetailCommand}" VerticalAlignment="Bottom" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="30,12" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="+ THÊM"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BgSurface}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding DanhSachChiTiet}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="45">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FE"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="15,10"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SẢN PHẨM" Binding="{Binding TenSP}" Width="2*"/>
                    <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding SoLuong}" Width="1*"/>
                    <DataGridTextColumn Header="ĐƠN GIÁ" Binding="{Binding DonGia, StringFormat=\{0:N0\} đ}" Width="1.5*"/>
                    <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding ThanhTien, StringFormat=\{0:N0\} đ}" Width="1.5*"/>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.EditDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" ToolTip="Sửa dòng này">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PrimaryColor}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa dòng này">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource DangerColor}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TỔNG CỘNG:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TongTienPhieu, StringFormat=\{0:N0\} đ}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerColor}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" Command="{Binding SaveCommand}" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="Bold" Padding="40,15" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LƯU HÓA ĐƠN NHẬP" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>