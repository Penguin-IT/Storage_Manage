<UserControl x:Class="QuanLyKho.Views.BaoCaoPhanTichView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <ComboBox Width="150" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,10,0"
                      ItemsSource="{Binding DanhSachKy}" SelectedItem="{Binding KyDuocChon}">
            </ComboBox>
            <Button Command="{Binding LamMoiCommand}" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOP NHÀ CUNG CẤP NHẬP NHIỀU NHẤT" FontWeight="Bold" FontSize="14" Foreground="#4A5568" Margin="0,0,0,30"/>

                    <ItemsControl ItemsSource="{Binding DanhSachTopNCC}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding TenNCC}" FontWeight="SemiBold" FontSize="13" Foreground="#2D3748" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding TongTien, StringFormat=\{0:N0\} đ}" FontWeight="Bold" FontSize="13" Foreground="#1A202C" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar Grid.Row="1" Value="{Binding PhanTram}" Maximum="100" Height="6" Background="#EDF2F7" Foreground="#4A3AFF" BorderThickness="0">
                                        <ProgressBar.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>