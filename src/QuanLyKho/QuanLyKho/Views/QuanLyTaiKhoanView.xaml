<UserControl x:Class="QuanLyKho.Views.QuanLyTaiKhoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Height="600" Width="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="493*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Thông Tin Tài Khoản" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                <TextBlock Text="Tên đăng nhập (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <TextBox Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,15"
                         Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Mật khẩu (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <TextBox Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,15"
                         Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Chọn Nhân viên (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <ComboBox Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,15"
                          ItemsSource="{Binding DanhSachNhanVien}" 
                          DisplayMemberPath="HoTen"
                          SelectedItem="{Binding NhanVienDuocChon, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Vai trò quyền truy cập" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                <ComboBox Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="0,0,0,25"
                          ItemsSource="{Binding DanhSachVaiTro}" 
                          SelectedItem="{Binding QuyenTruyCap, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Command="{Binding AddCommand}" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="Bold" Padding="0,15" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"/>
                        <TextBlock Text="THÊM TÀI KHOẢN" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Grid.RowSpan="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding DanhSachTaiKhoan}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeight="50" Margin="10">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="TÊN ĐĂNG NHẬP" Binding="{Binding TenDangNhap}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="NGƯỜI SỞ HỮU" Binding="{Binding NhanVien.HoTen}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#334155"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="VAI TRÒ QUYỀN" Binding="{Binding QuyenTruyCap}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="0.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Khóa tài khoản này" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource DangerColor}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>